<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>XBar</AssemblyName>
    <RootNamespace>XBar.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>XBar.App.Program</StartupObject>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\XBar.Core\XBar.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="System.IO" />
    <!-- WinForms is only used for the tray icon; keep its names out of the global scope -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <!-- Explorer-side DLL, built by src/XBar.Tap (copied if present) -->
  <ItemGroup>
    <None Include="..\..\artifacts\tap\XBar.Tap.dll" Condition="Exists('..\..\artifacts\tap\XBar.Tap.dll')">
      <Link>XBar.Tap.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\tools\restore.ps1">
      <Link>restore.ps1</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
