<UserControl x:Class="XBar.App.UI.AppearanceEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:XBar.App.UI"
             x:Name="Root">
    <!-- DataContext: XBar.Core.Config.Appearance. Basic look: on/off, material, tint. -->
    <Border Style="{StaticResource Card}">
        <StackPanel>
            <HeaderedContentControl Style="{StaticResource Row}"
                                    Header="{Binding Title, ElementName=Root}"
                                    Tag="{Binding Description, ElementName=Root}">
                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Enabled}"
                          Visibility="{Binding ShowEnable, ElementName=Root, Converter={x:Static ui:BoolToVisibilityConverter.Instance}}" />
            </HeaderedContentControl>

            <StackPanel IsEnabled="{Binding Enabled}">
                <Separator Style="{StaticResource RowDivider}" />
                <HeaderedContentControl Style="{StaticResource Row}" Header="Material">
                    <ComboBox Width="160" ItemsSource="{x:Static ui:EnumLists.AccentModes}" SelectedItem="{Binding Accent}" />
                </HeaderedContentControl>
                <Separator Style="{StaticResource RowDivider}" />
                <HeaderedContentControl Style="{StaticResource Row}" Header="Tint">
                    <ui:ColorField Color="{Binding Color}" />
                </HeaderedContentControl>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
